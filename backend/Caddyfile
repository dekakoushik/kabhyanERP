{
	auto_https off
	frankenphp
	order php_server before file_server
}

:80 {
	root * /var/www/html/public
	encode zstd gzip

	php_server

	request_body {
		max_size 64MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	file_server
}
