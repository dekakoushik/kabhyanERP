# ==============================================================================
# Kabhyan ERP - Production Docker Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME=KabhyanERP
APP_ENV=production
APP_KEY=base64:3Y3P4L1kZ9k+hN7T9k0J1a2B3c4D5e6F7g8H9i0J1k2=
APP_DEBUG=false

# URLs & Public Exposure (Replace with your production domain in Dokploy)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Port Bindings
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=3306
REDIS_PORT=6379

# Database Configuration (MariaDB)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_DATABASE=kabhyan_erp
DB_USERNAME=kabhyan_user
DB_PASSWORD=KabhyanSecurePass@2026
DB_ROOT_PASSWORD=RootSecurePass@2026

# Redis In-Memory Cache & Session Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=predis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Automatic Startup Routine
RUN_MIGRATIONS=true
RUN_SEEDERS=false

