# Dependencies
/backend/vendor/
/frontend/node_modules/

# Environment files
*.env
*.env.*
!.env.example
!/backend/.env.example
!/frontend/.env.example

# Next.js build output
/frontend/.next/
/frontend/out/

# Laravel storage and caches
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/bootstrap/cache/*

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

